{
	"name": "unidaily",
	"version": "1.0.4",
	"description": "Single-file daily journal with quick capture, tag suggestions and a sidebar calendar.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "node --test \"tests/**/*.test.ts\""
	},
	"keywords": [
		"obsidian",
		"daily notes",
		"journal",
		"capture"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^16.0.0",
		"obsidian": "latest",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
